# Concursei — somente este diretório (public/) deve ser exposto pelo Apache.

Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off

# Caminho do diretório privado (ajuste no servidor se não usar o padrão ~/concursei).
# SetEnv CONCURSEI_APP_ROOT /home/USUARIO/concursei

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Força HTTPS (ative após confirmar o certificado no cPanel).
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Bloqueia arquivos ocultos (.env, .git, .htaccess) e backups/configs.
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(env|ini|log|sql|bak|backup|dump|sh|lock|dist|json|md|yml|yaml|twig|phtml)$ - [F,L,NC]

    # Qualquer outro .php além do front controller é proibido.
    RewriteCond %{REQUEST_URI} !^/index\.php$
    RewriteRule \.php$ - [F,L,NC]

    # Arquivos estáticos existentes são servidos diretamente; o resto vai ao front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(css|js|woff2|png|jpe?g|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

# SVG enviado por usuário não é aceito; SVG estático próprio é servido sem execução de script.
<FilesMatch "\.svg$">
    <IfModule mod_headers.c>
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'"
    </IfModule>
</FilesMatch>

# Concursei — exemplo de configuração. NUNCA coloque valores reais neste arquivo.
# Copie para o diretório PRIVADO como ".env" (fora de public_html) e preencha lá.

# --- Aplicação ---
APP_NAME=Concursei
# local | testing | staging | production
APP_ENV=local
APP_DEBUG=false
# URL canônica, sem barra final e sem caminho. Em produção deve ser https.
APP_URL=http://localhost:8000
# Gere com: php bin/console key:generate --write
APP_KEY=
# Ative somente depois de confirmar HTTPS válido em todo o domínio.
APP_HSTS=false
APP_DISPLAY_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info
# Identidade do operador exibida em privacidade/termos (pendência obrigatória antes de produção).
OPERATOR_NAME=
CONTACT_EMAIL=

# --- Banco de dados (usuário com privilégio mínimo; nunca root) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=concursei
DB_USERNAME=concursei_app
DB_PASSWORD=

# --- Proxies confiáveis (CIDRs separados por vírgula). Vazio = ignora X-Forwarded-For. ---
TRUSTED_PROXIES=

# --- Sessão (segundos) ---
SESSION_IDLE_SECONDS=7200
SESSION_ABSOLUTE_SECONDS=1209600
SESSION_REAUTH_SECONDS=900

# --- E-mail transacional ---
# smtp = envio real | capture = só desenvolvimento (grava .eml em storage/mail) | disabled
# Em production/staging, "capture" é tratado como desabilitado (cadastro e recuperação ficam indisponíveis).
MAIL_TRANSPORT=disabled
# Use a caixa de e-mail criada no cPanel da hospedagem (ou um provedor transacional contratado).
SMTP_HOST=mail.example.com
SMTP_PORT=587
# starttls (587) | smtps (465)
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=nao-responda@example.com
SMTP_PASSWORD=
SMTP_TIMEOUT=10
MAIL_FROM_ADDRESS=nao-responda@example.com
MAIL_FROM_NAME=Concursei
# Máximo por execução do Cron (respeite o limite horário de envio da hospedagem).
MAIL_BATCH_SIZE=20

# --- Catálogo ---
# true = quem enviou o concurso para revisão não pode publicá-lo (revisão em duas pessoas).
CATALOG_FOUR_EYES=false

# Concursei — exemplo de configuração. NUNCA coloque valores reais neste arquivo.
# Copie para o diretório PRIVADO como ".env" (fora de public_html) e preencha lá.

# --- Aplicação ---
APP_NAME=Concursei
# local | testing | staging | production
APP_ENV=local
APP_DEBUG=false
# URL canônica, sem barra final e sem caminho. Em produção deve ser https.
APP_URL=http://localhost:8000
# Gere com: php bin/console key:generate --write
APP_KEY=
# Ative somente depois de confirmar HTTPS válido em todo o domínio.
APP_HSTS=false
APP_DISPLAY_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info
# Identidade do operador exibida em privacidade/termos (pendência obrigatória antes de produção).
OPERATOR_NAME=
CONTACT_EMAIL=

# --- Banco de dados (usuário com privilégio mínimo; nunca root) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=concursei
DB_USERNAME=concursei_app
DB_PASSWORD=

# --- Proxies confiáveis (CIDRs separados por vírgula). Vazio = ignora X-Forwarded-For. ---
TRUSTED_PROXIES=

# --- Sessão (segundos) ---
SESSION_IDLE_SECONDS=7200
SESSION_ABSOLUTE_SECONDS=1209600
SESSION_REAUTH_SECONDS=900

# --- E-mail transacional ---
# smtp = envio real | capture = só desenvolvimento (grava .eml em storage/mail) | disabled
# Em production/staging, "capture" é tratado como desabilitado (cadastro e recuperação ficam indisponíveis).
MAIL_TRANSPORT=disabled
# Use a caixa de e-mail criada no cPanel da hospedagem (ou um provedor transacional contratado).
SMTP_HOST=mail.example.com
SMTP_PORT=587
# starttls (587) | smtps (465)
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=nao-responda@example.com
SMTP_PASSWORD=
SMTP_TIMEOUT=10
MAIL_FROM_ADDRESS=nao-responda@example.com
MAIL_FROM_NAME=Concursei
# Máximo por execução do Cron (respeite o limite horário de envio da hospedagem).
MAIL_BATCH_SIZE=20

# --- Catálogo ---
# true = quem enviou o concurso para revisão não pode publicá-lo (revisão em duas pessoas).
CATALOG_FOUR_EYES=false

# --- Fila e Cron (um único Cron: php bin/console schedule:run, ex.: a cada 5 min) ---
# Reserva de um job em execução (s). queue:work nunca roda por mais que isso menos 30 s.
JOBS_LEASE_SECONDS=300
# Por chamada do agendador. Ajuste após medir o tempo máximo do PHP CLI na hospedagem.
JOBS_MAX_PER_RUN=5
JOBS_MAX_SECONDS=40

# --- Coletor de fontes oficiais (somente HTTPS, hosts cadastrados pela equipe) ---
# Tamanho máximo por documento, já descomprimido (bytes) e tempo total por requisição (s).
COLLECTOR_MAX_BYTES=15728640
COLLECTOR_TIMEOUT=30

# --- IA (Gemini) — chave SOMENTE aqui no .env privado; nunca no navegador, Git, URL ou log ---
# rest = API real | disabled. ("fake" só existe nos testes automatizados.)
GEMINI_TRANSPORT=rest
# Vazio = IA indisponível (a extração de editais fica desativada, sem simular resultado).
GEMINI_API_KEY=
# Escolha um modelo estável vigente em https://ai.google.dev/gemini-api/docs/models (sem valor padrão).
GEMINI_MODEL=
GEMINI_TIMEOUT=90
# Tetos de uso em tokens (entrada + saída) por dia e por mês. Converta para reais pelo preço vigente do modelo antes de ativar.
AI_DAILY_BUDGET=1000000
AI_MONTHLY_BUDGET=10000000
AI_DAILY_CALL_LIMIT=200
# Extração de editais: caracteres enviados por chamada e limite de saída (confira o máximo do modelo escolhido).
AI_EDITAL_MAX_INPUT_CHARS=120000
AI_EDITAL_MAX_OUTPUT_TOKENS=8192

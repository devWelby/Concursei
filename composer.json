{
    "name": "concursei/concursei",
    "description": "Concursei — plataforma de concursos públicos em PHP puro (sem framework) para hospedagem compartilhada.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "phpmailer/phpmailer": "^6.10",
        "spomky-labs/otphp": "^11.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Concursei\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Concursei\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.12"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:security": "phpunit --testsuite security",
        "lint": "php scripts/lint.php",
        "safety": "php scripts/check-repository-safety.php --tracked",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 127.0.0.1:8000 -t public scripts/dev/router.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

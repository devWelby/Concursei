#!/usr/bin/env php
<?php

declare(strict_types=1);

// Somente linha de comando (Cron/SSH). Nunca exposto via HTTP.
if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit(1);
}

$root = dirname(__DIR__);
require $root . '/vendor/autoload.php';

/** @var \Concursei\Core\App $app */
$app = (require $root . '/bootstrap/app.php')($root);
$console = new \Concursei\Core\Console\Console($app);
\Concursei\Core\Console\CoreCommands::register($console);
foreach ($app->consoleRegistrars() as $registrar) {
    $registrar($console);
}
exit($console->run($argv));
